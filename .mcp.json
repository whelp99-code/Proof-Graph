{
  "mcpServers": {
    "proofgraph": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {
        "PROOFGRAPH_DATA_DIR": "${CLAUDE_PLUGIN_DATA}",
        "PROOFGRAPH_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "PROOFGRAPH_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "PROOFGRAPH_TEST_MODE": "0"
      }
    }
  }
}
