{
  "name": "@proofgraph/standalone",
  "version": "5.0.0",
  "description": "ProofGraph Standalone AI Organization OS with truthful execution modes, native model gateway, sandbox tools, collaboration workers, and operator TUI.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proofgraph": "./bin/proofgraph.mjs",
    "proofgraphd": "./bin/proofgraphd.mjs",
    "proofgraph-org": "./bin/proofgraph-org.mjs",
    "proofgraph-org-mcp": "./runtime/mcp/server.mjs"
  },
  "exports": {
    ".": "./runtime/index.mjs",
    "./task-intelligence": "./runtime/task-intelligence/index.mjs",
    "./organization": "./runtime/organization/index.mjs",
    "./company": "./runtime/company/index.mjs",
    "./os": "./runtime/os/index.mjs",
    "./integration/v1.1": "./runtime/integration/v1-1-port.mjs",
    "./observability": "./runtime/observability/index.mjs",
    "./control-plane": "./runtime/control-plane/index.mjs",
    "./operator": "./runtime/operator/index.mjs",
    "./hosts": "./runtime/hosts/index.mjs",
    "./intelligence": "./runtime/intelligence/index.mjs",
    "./providers": "./runtime/providers/index.mjs",
    "./tools": "./runtime/tools/index.mjs",
    "./workers": "./runtime/workers/index.mjs"
  },
  "files": [
    "bin/",
    "runtime/",
    "docs/",
    "examples/",
    "README.md",
    "README_KO.md",
    "DEVELOPMENT_PLAN.md",
    "DEVELOPMENT_PLAN_V1_2_TO_V2_0_KO.md",
    "CHANGELOG.md",
    "HERMES_V1_1_TO_V2_0_INTEGRATION_KO.md",
    "LICENSE",
    "scripts/",
    "INTEGRATION_MANIFEST.json",
    "SBOM.json",
    "DEVELOPMENT_PLAN_OPERATOR_TUI_V2_0_1_TO_V3_0_0_KO.md",
    "MILESTONE_IMPLEMENTATION_REPORT_KO.md",
    "HERMES_V1_1_TO_V3_OPERATOR_INTEGRATION_KO.md",
    "BUILD_MANIFEST.json",
    "DEVELOPMENT_PLAN_INTELLIGENCE_FABRIC_V3_1_TO_V4_0_KO.md",
    "CODE_AUDIT_INTELLIGENCE_FABRIC_KO.md",
    "DEVELOPMENT_PLAN_STANDALONE_V4_0_1_TO_V5_0_0_KO.md"
  ],
  "scripts": {
    "test": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/**/*.test.mjs",
    "test:unit": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/unit/*.test.mjs",
    "test:integration": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/integration/*.test.mjs",
    "test:adversarial": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/adversarial/*.test.mjs",
    "verify:independent": "node verification/independent-verifier.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "release:verify": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 npm test && npm run coverage && npm run benchmark:operator && npm run preflight && npm run verify:independent && npm run verify:operator && npm run verify:intelligence && npm run build:manifest && npm run verify:package && npm run verify:standalone",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:release": "npm run build:manifest && python3 scripts/build-release.py",
    "coverage": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node scripts/run-coverage.mjs",
    "test:operator": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/operator/*.test.mjs",
    "test:control-plane": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/control-plane/*.test.mjs",
    "test:host": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/hosts/*.test.mjs",
    "verify:operator": "node verification/operator-independent-verifier.mjs",
    "benchmark:operator": "node scripts/benchmark-operator.mjs",
    "test:intelligence": "PROOFGRAPH_ALLOW_SIMULATION_PROMOTION=1 node --test --test-reporter=spec tests/intelligence/*.test.mjs",
    "verify:intelligence": "node verification/intelligence-independent-verifier.mjs",
    "verify:standalone": "node verification/standalone-independent-verifier.mjs"
  }
}
