{
  "schema_version": 1,
  "graph_id": "graph_ai_agent_tui_v1",
  "name": "AI Agent TUI development",
  "objective": "Develop a secure dependency-free operator TUI for ProofGraph AI agent runs. It must list runs; render graph nodes, agent state, events, failures, integrity, and approvals; inspect selected nodes; support pause, resume, and single-step through debugger APIs; approve or deny pending approvals and abort runs only through bounded double-key confirmation; restore terminal state on every exit path; provide responsive wide, narrow, and non-interactive snapshot modes; and pass functional plus adversarial independent verification.",
