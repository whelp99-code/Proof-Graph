      }
    },
    {
      "node_id": "plan",
      "title": "Design TUI architecture and acceptance contract",
      "kind": "plan",
      "role": "planner",
      "max_attempts": 4,
      "join": "all",
      "agent_type": "proofgraph-claude:graph-planner",
      "model_tier": "deep",
      "tool_policy": [
        "proofgraph",
        "workspace_read"
      ],
      "metadata": {
        "join_from": [
          "research-runtime",
          "research-ux",
          "research-safety"
        ],
        "deliverables": [
          "verified-view-model",
          "responsive-renderer",
          "keyboard-controller",
          "approval-and-abort-controls",
          "failure-and-integrity-inspector",
          "snapshot-mode",
          "terminal-restoration",
          "tests-and-operator-guide"
        ],
        "acceptance_contract": [
          "No direct state.json mutation from the TUI",
          "Pause, resume, and step use DebuggerController only",
          "Approve, deny, and abort use GraphKernel only and require double-key confirmation",
          "Corrupt runs remain visible as integrity_error and cannot crash the UI",
          "Snapshot mode works without a TTY",
          "Interactive exit always restores raw mode, cursor, and alternate screen"
        ]
      }
    },
    {
      "node_id": "develop-model",
