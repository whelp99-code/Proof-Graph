          "select-node",
          "pause",
          "resume",
          "single-step",
          "approve",
          "deny",
          "abort",
          "refresh",
          "help",
          "quit"
        ],
        "destructive_confirmation": {
          "type": "same-key-double-press",
          "window_seconds": 4
        },
        "mutation_boundary": "GraphKernel and DebuggerController only"
      }
    },
    {
      "node_id": "verify-functional",
