        "workspace_read"
      ],
      "metadata": {
        "verification_strength": "standard",
        "acceptance_tests": [
          "wide and narrow panels remain bounded",
          "run and node selection is deterministic",
          "pause, resume, and step call debugger APIs",
          "approve, deny, and abort require two matching keys",
          "snapshot mode works without a TTY",
          "selected node output and Failure Packet are inspectable"
        ]
      }
    },
    {
      "node_id": "verify-adversarial",
      "title": "Adversarially verify corrupt state, terminal injection, confirmation bypass, and cleanup",
      "kind": "verify",
      "role": "verifier",
      "max_attempts": 5,
      "agent_type": "proofgraph-claude:graph-verifier-deep",
      "model_tier": "deep",
      "tool_policy": [
        "proofgraph",
        "workspace_read"
      ],
      "metadata": {
        "verification_strength": "deep",
        "acceptance_tests": [
          "ANSI and control sequence injection is stripped",
          "corrupt or semantically tampered run state is fail-closed",
          "wrong, expired, or mismatched confirmation cannot execute destructive actions",
          "narrow and non-TTY modes do not crash",
          "exceptions and Ctrl-C restore terminal raw mode, cursor, and alternate screen",
          "TUI cannot bypass GraphKernel, approval challenge, or debugger policy"
        ]
      }
    },
