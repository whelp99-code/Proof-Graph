{
  "schema_version": 1,
  "default_adapter": "orca",
  "data_dir": ".proofgraph",
  "routing": {
    "direct": "orca",
    "researcher": "orca",
    "planner": "orca",
    "developer": "orca",
    "verifier": "orca",
    "synthesizer": "orca"
  },
  "kernel": {
    "max_orchestration_rounds": 80,
    "max_context_nodes": 24,
    "max_context_bytes": 512000,
    "fail_fast_on_adapter_error": false
  },
  "workspace": {
    "enabled": false,
    "backend": "git-worktree",
    "require_approval": true,
    "require_clean": true,
    "allowed_commands": [],
    "command_timeout_ms": 300000,
    "max_command_output_bytes": 1000000
  },
  "debugger": {
    "enabled": true,
    "event_poll_ms": 250
  },
  "adapters": {
    "orca": {
      "enabled": false,
      "command": "orca",
      "args": [],
      "repo_selector": null,
      "setup": "inherit",
      "coordinator_terminal": null,
      "manual_permissions_confirmed": false,
      "agent_map": {
        "direct": "claude",
        "researcher": "claude",
        "planner": "claude",
        "developer": "codex",
        "verifier": "claude",
        "synthesizer": "claude"
      },
      "allowed_agents": [
        "claude",
        "codex"
      ],
      "allow_node_agent_override": false,
      "allow_workspace_mutation": false,
      "allow_inline_result": false,
      "check_timeout_ms": 900000,
      "terminal_wait_ms": 60000,
      "max_checkpoints": 2,
      "max_spec_bytes": 60000,
      "max_report_bytes": 1000000,
      "report_dir": ".proofgraph/orca-results",
      "require_explicit_repo_selector": true
    }
  },
  "templates": {}
}
